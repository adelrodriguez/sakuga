{
  "extends": "adamantite/typescript",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "types": ["bun"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "allowedUnstableApis": ["effect/cli", "effect/process"]
      }
    ]
  },
  "include": ["src/**/*.ts", "scripts/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", ".packref"]
}
