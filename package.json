{
  "name": "sakuga",
  "version": "0.1.0",
  "description": "Create code animations",
  "keywords": [
    "animation",
    "cli",
    "code",
    "video"
  ],
  "homepage": "https://github.com/adelrodriguez/sakuga#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/sakuga/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/sakuga.git"
  },
  "bin": {
    "sakuga": "bin/sakuga"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "adamantite check",
    "dev": "bunup --watch",
    "fix": "adamantite fix",
    "prepare": "adamantite prepare",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "version": "changeset version && adamantite fix"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@napi-rs/canvas": "^0.1.88",
    "effect": "4.0.0",
    "marked": "^17.0.1",
    "shiki": "^3.21.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@effect/language-service": "^0.87.3",
    "@effect/tsgo": "0.48.0",
    "@types/bun": "1.3.5",
    "adamantite": "^0.43.0",
    "bunup": "0.16.17",
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "packref": "0.3.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.1"
}
